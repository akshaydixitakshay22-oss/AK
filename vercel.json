{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}